generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  password           String
  batch              String?
  department         String?
  role               String            @default("junior")
  bio                String?
  skills             String?
  createdAt          DateTime          @default(now())
  bloodGroup         String?
  studentId          String?
  gender             String?
  avatar             String?
  emailVerified      Boolean           @default(false)
  resetExpiry        DateTime?
  resetToken         String?
  verificationExpiry DateTime?
  verificationOTP    String?
  googleId           String?           @unique
  bloodDonor         BloodDonor?
  bloodRequests      BloodRequest[]
  buyRequests        BuyRequest[]
  comments           Comment[]
  commentReactions   CommentReaction[]
  receivedRequests   Connection[]      @relation("ReceivedRequests")
  sentRequests       Connection[]      @relation("SentRequests")
  likes              Like[]
  marketItems        MarketItem[]
  receivedMessages   Message[]         @relation("ReceivedMessages")
  sentMessages       Message[]         @relation("SentMessages")
  sentNotifications  Notification[]    @relation("NotificationSender")
  notifications      Notification[]    @relation("NotificationUser")
  posts              Post[]
  resources          Resource[]
}

model Connection {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedRequests", fields: [receiverId], references: [id])
  sender     User     @relation("SentRequests", fields: [senderId], references: [id])
}

model Post {
  id        Int         @id @default(autoincrement())
  content   String?
  type      String      @default("general")
  userId    Int
  createdAt DateTime    @default(now())
  comments  Comment[]
  likes     Like[]
  user      User        @relation(fields: [userId], references: [id])
  images    PostImage[]
}

model PostImage {
  id     Int    @id @default(autoincrement())
  url    String
  postId Int
  post   Post   @relation(fields: [postId], references: [id])
}

model Comment {
  id        Int               @id @default(autoincrement())
  content   String
  userId    Int
  postId    Int
  createdAt DateTime          @default(now())
  parentId  Int?
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]         @relation("CommentReplies")
  post      Post              @relation(fields: [postId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  reactions CommentReaction[]
}

model CommentReaction {
  id        Int     @id @default(autoincrement())
  userId    Int
  commentId Int
  emoji     String
  comment   Comment @relation(fields: [commentId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
}

model Like {
  id     Int  @id @default(autoincrement())
  userId Int
  postId Int
  post   Post @relation(fields: [postId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  senderId  Int
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  metadata  String?
  sender    User     @relation("NotificationSender", fields: [senderId], references: [id])
  user      User     @relation("NotificationUser", fields: [userId], references: [id])
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String?
  senderId   Int
  receiverId Int
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  fileType   String?
  fileUrl    String?
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  courses   Course[]
}

model Course {
  id           Int        @id @default(autoincrement())
  code         String
  name         String
  departmentId Int
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  resources    Resource[]

  @@unique([code, departmentId])
}

model Resource {
  id        Int      @id @default(autoincrement())
  title     String
  fileUrl   String
  fileType  String
  examType  String
  courseId  Int
  userId    Int
  createdAt DateTime @default(now())
  aiSummary String?
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model MarketItem {
  id          Int               @id @default(autoincrement())
  title       String
  description String
  price       Float
  condition   String
  category    String
  userId      Int
  status      String            @default("available")
  createdAt   DateTime          @default(now())
  buyRequests BuyRequest[]
  user        User              @relation(fields: [userId], references: [id])
  images      MarketItemImage[]
}

model MarketItemImage {
  id     Int        @id @default(autoincrement())
  url    String
  itemId Int
  item   MarketItem @relation(fields: [itemId], references: [id])
}

model BuyRequest {
  id        Int        @id @default(autoincrement())
  itemId    Int
  buyerId   Int
  message   String?
  status    String     @default("pending")
  createdAt DateTime   @default(now())
  buyer     User       @relation(fields: [buyerId], references: [id])
  item      MarketItem @relation(fields: [itemId], references: [id])
}

model BloodRequest {
  id          Int      @id @default(autoincrement())
  bloodGroup  String
  patientName String
  hospital    String
  location    String
  contact     String
  details     String?
  urgent      Boolean  @default(false)
  status      String   @default("active")
  userId      Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model BloodDonor {
  id               Int       @id @default(autoincrement())
  bloodGroup       String
  location         String
  whatsapp         String
  lastDonationDate DateTime?
  available        Boolean   @default(true)
  userId           Int       @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}
